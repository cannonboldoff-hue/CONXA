# Copy this file to .env and fill in the values below.
# Variables not listed here have sensible defaults in conxa_core/config.py — override only if needed.

# ============================================================================
# LLM Key Pool — three symmetric, single-deployment tiers
# ============================================================================
# Every plan routes through a real, billed provider (docs/cost_model.md
# "LLM Provider Strategy", 2026-09-23) — the old multi-provider free-tier-
# rotation pool (Groq/Google AI Studio/NVIDIA NIM/Cerebras/Together/Mistral/
# FreeLLMAPI) was retired. Free and Starter run on OpenRouter; Pro runs direct
# against Anthropic. Each tier is its OWN independent single-deployment block —
# own provider label, own endpoint, own keys, own text/vision models, own
# fallback models (tried on the same key if the primary model fails). An unset
# LLM_{TIER}_API_KEYS means that plan contributes no pool entries and its
# compiles fall back to the Free pool. See docs/TRD.md §13.2.
#
# Each tier:
#   *_API_KEYS — comma-separated keys (rotated round-robin across requests)
#   *_TEXT_MODEL / *_VISION_MODEL — leave blank to use the default model
#
# The router:
#   - builds a flat pool of (provider, key, model) tuples across all enabled
#     tiers, sorted by remaining budget
#   - on 429 / rate-limit: cools the offending key for LLM_ROUTER_COOLDOWN_SECS
#     and tries the next entry
#   - on 401 / 403: quarantines the key for a while, then retries it
#   - vision calls only route to providers with a *_VISION_MODEL set

# --- Free: GLM 5.3 Flash text + Qwen3 VL 235B A22B Instruct vision, via OpenRouter ---
# Sign up: https://openrouter.ai/keys
# Paid, pay-as-you-go — +5.5% OpenRouter platform fee on top of list price.
LLM_FREE_PROVIDER=openrouter
LLM_FREE_ENDPOINT=https://openrouter.ai/api/v1
LLM_FREE_API_KEYS=
LLM_FREE_TEXT_MODEL=z-ai/glm-5.3-flash
LLM_FREE_VISION_MODEL=qwen/qwen3-vl-235b-a22b-instruct
LLM_FREE_FALLBACK_TEXT_MODEL=
LLM_FREE_FALLBACK_VISION_MODEL=
LLM_FREE_MULTIMODAL_MODEL=                # optional — Copilot's screenshot turns; falls back to LLM_FREE_VISION_MODEL
LLM_FREE_FALLBACK_MULTIMODAL_MODEL=

# --- Starter: Kimi K3 text + Qwen3 VL 235B A22B Instruct vision, via OpenRouter ---
# Usually the same OpenRouter key as Free above, on its own var so Starter
# access can be rotated/revoked independently.
LLM_STARTER_PROVIDER=openrouter
LLM_STARTER_ENDPOINT=https://openrouter.ai/api/v1
LLM_STARTER_API_KEYS=
LLM_STARTER_TEXT_MODEL=moonshotai/kimi-k3
LLM_STARTER_VISION_MODEL=qwen/qwen3-vl-235b-a22b-instruct
LLM_STARTER_FALLBACK_TEXT_MODEL=
LLM_STARTER_FALLBACK_VISION_MODEL=
LLM_STARTER_MULTIMODAL_MODEL=             # optional — Copilot's screenshot turns; falls back to LLM_STARTER_VISION_MODEL
LLM_STARTER_FALLBACK_MULTIMODAL_MODEL=

# --- Pro: Claude Sonnet 5 text + Claude Opus 5.5 vision, direct to Anthropic ---
# No OpenRouter fee. Routes through Anthropic's own OpenAI-compatible endpoint
# (same request/response shape as every other pooled provider — no BYOK-style
# auth needed). Verify these model-id strings against Anthropic's live model
# catalog before deploying.
LLM_PRO_PROVIDER=anthropic
LLM_PRO_ENDPOINT=https://api.anthropic.com/v1
LLM_PRO_API_KEYS=
LLM_PRO_TEXT_MODEL=claude-sonnet-5
LLM_PRO_VISION_MODEL=claude-opus-5-5
LLM_PRO_FALLBACK_TEXT_MODEL=
LLM_PRO_FALLBACK_VISION_MODEL=
LLM_PRO_MULTIMODAL_MODEL=                 # optional — Copilot's screenshot turns; falls back to LLM_PRO_VISION_MODEL
LLM_PRO_FALLBACK_MULTIMODAL_MODEL=

# --- Router behavior ---
LLM_ROUTER_COOLDOWN_SECS=60               # how long to cool a key after 429
LLM_ROUTER_MAX_RETRIES=3                  # retries before giving up on a request
LLM_ROUTER_REQUEST_TIMEOUT_MS=30000       # per-request timeout
LLM_ROUTER_PREFER_FAST_FOR_TEXT=true      # prefer the fastest text-only provider when available

# Conxa Execute has no dedicated LLM deployment of its own — its chat calls
# always draw from the workspace's own tier pool above (Free/Starter/Pro).

# ============================================================================
# Dependency Manifest (served by /api/v1/updates/deps-manifest)
# All deps are independently versioned — update these without releasing a new
# Build Studio version. Set on Render; leave SHA256 fields blank until CI
# computes them from the published release assets.
# ============================================================================

# GitHub repo that hosts release artifacts (runtime, studio installer)
CONXA_GITHUB_REPO=cannonboldoff-hue/CONXA

# ── NSIS (Windows installer compiler) ──────────────────────────────────────
CONXA_NSIS_VERSION=3.10
CONXA_NSIS_URL=https://downloads.sourceforge.net/project/nsis/NSIS%203/3.10/nsis-3.10.zip
CONXA_NSIS_SHA256=

# ── MCP Runtime — host layer (conxa-runtime.exe, ~85 MB, quarterly) ────────
# CI posts these after each host-v* tag build. Download URLs are derived from
# CONXA_HOST_VERSION + CONXA_GITHUB_REPO — no URL vars needed.
CONXA_HOST_VERSION=host-v1.0.0
CONXA_HOST_WIN_SHA256=
CONXA_KEYTAR_WIN_SHA256=

# ── MCP Runtime — app layer (~60 KB zip, every code release) ─────────────────
# CI posts these after each app-v* tag build. Bundle URL is derived from
# CONXA_APP_VERSION + CONXA_GITHUB_REPO — no URL var needed.
CONXA_APP_VERSION=app-v1.0.0
CONXA_APP_MIN_HOST=host-v1.0.0
CONXA_APP_BUNDLE_SHA256=

# ── Cloud admin token (used by CI to POST updated manifests after each build) ─
CONXA_ADMIN_TOKEN=

# ── Playwright / Chromium — informational only ─────────────────────────────
# Baked into the PyInstaller bundle; cannot update without a new Build Studio
# release. Exposed here so the runtime-manifest endpoint can tell the runtime
# which Chromium revision to install.
CONXA_PLAYWRIGHT_VERSION=1.59.0
CONXA_CHROMIUM_REVISION=1227

# ── Build Studio installer manifest ────────────────────────────────────────
# Served by /api/v1/updates/studio-manifest and /updates/studio/latest.yml.
# Only CONXA_STUDIO_VERSION is required — the win URL and latest.yml URL are
# derived from it automatically. Set the override vars only when hosting
# artifacts outside GitHub Releases.
CONXA_STUDIO_VERSION=studio-v1.0.0
# CONXA_STUDIO_WIN_SHA256=
# CONXA_STUDIO_WIN_URL=         # override only if not on GitHub Releases
# CONXA_STUDIO_LATEST_YML_URL=  # override only if not on GitHub Releases

# ── Runtime CDN base (used by installer_builder.py when staging runtime) ───
CONXA_RUNTIME_CDN_URL=https://github.com/cannonboldoff-hue/CONXA/releases/download

# ── Build Studio → Cloud API base URL ──────────────────────────────────────
# bootstrap.py fetches the deps-manifest from this host on every startup.
CONXA_CLOUD_API=https://apis.conxa.in

# ── Client-side manifest cache TTL (seconds, default 86400 = 24 h) ─────────
CONXA_DEPS_MANIFEST_TTL_SECONDS=86400

# ============================================================================
# Auth + Production
# ============================================================================

# Build Studio Electron app — Clerk OAuth credentials.
# CONXA_CLERK_CLIENT_SECRET must be set in the shell (or CI env) before `npm run dev`
# or `npm run build`. It is never committed to source code.
# Obtain from: Clerk Dashboard → Applications → <app> → OAuth Applications.
CONXA_CLERK_DOMAIN=https://clerk.conxa.in
CONXA_CLERK_CLIENT_ID=Z7O8UdIVowd3Aegx
CONXA_CLERK_CLIENT_SECRET=

# Cloud backend — Clerk auth. Set SKILL_AUTH_REQUIRED=true outside local/dev.
# Issuer = Frontend API URL from Clerk (e.g. https://<instance>.clerk.accounts.dev).
# JWKS URL = same host + /.well-known/jwks.json
SKILL_AUTH_REQUIRED=false
SKILL_CLERK_ISSUER=
SKILL_CLERK_JWKS_URL=
SKILL_CLERK_AUTHORIZED_PARTIES=
SKILL_CLERK_AUDIENCE=
# Clerk Backend API secret (sk_...). Required for admin-gated actions (e.g. publish)
# from Build Studio: its OAuth access token carries org_id but not org_role, so the
# backend resolves the caller's org role via the Clerk Backend API. Without this,
# org members are treated as non-admins and publish returns 403 "admin role required".
CLERK_SECRET_KEY=
# Shared secret used only between the Next.js API proxy and the cloud backend.
# Set the same high-entropy value as CONXA_API_PROXY_SECRET in the Vercel frontend env.
# Without this, the backend cannot resolve the active Clerk org from proxy headers and
# falls back to JWT claims — org-scoped features (skill packs, billing) may misbehave.
SKILL_API_PROXY_SHARED_SECRET=

# Production backing services
SKILL_DATABASE_URL=
SKILL_REDIS_URL=
SKILL_BLOB_READ_WRITE_TOKEN=

# Public API base URL embedded in pack.json (sync + telemetry endpoints).
# Must be set in production (SKILL_AUTH_REQUIRED=true) to prevent X-Forwarded-Host injection.
# Example: https://api.conxa.in
SKILL_API_BASE_URL=

# Cashfree billing (merchant.cashfree.com -> Developers -> API Keys)
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_WEBHOOK_SECRET=
# TEST (sandbox) or PROD
CASHFREE_ENV=TEST
# Pre-create monthly INR plans in the Cashfree Subscription Management dashboard.
# Starter: ₹19,999/month. Pro: ₹49,999/month.
CASHFREE_STARTER_PLAN_ID=
CASHFREE_PRO_PLAN_ID=
# Compile add-on packs are ONE-TIME purchases via Cashfree Payment Links —
# no plan IDs needed for them (only CASHFREE_APP_ID / CASHFREE_SECRET_KEY).

# Dashboard "Report a bug" page — sends the report by email via Resend's HTTPS
# API (Render's free plan blocks outbound SMTP ports, so plain SMTP won't work).
# Sign up at resend.com for the key. Leave blank to disable the feature (503).
SKILL_RESEND_API_KEY=
SKILL_BUG_REPORT_TO_EMAIL=
# Must stay onboarding@resend.dev (works without domain verification, but only
# when SKILL_BUG_REPORT_TO_EMAIL is the Resend account owner's own address)
# until a sending domain is verified in Resend.
SKILL_BUG_REPORT_FROM_EMAIL=Conxa Bug Reports <onboarding@resend.dev>

# ── Agent-installer code signing (Phase 2.5) — scaffolding, awaiting cert ─────
# Read by conxa_compile/installer_builder.py when the Build Studio builds a
# customer's Agent .exe. Leave blank until an EV/OV certificate is available;
# when blank, signing is skipped and Windows SmartScreen shows
# "Unknown Publisher". CONXA_SIGN_CERT_SHA1 is the thumbprint of a cert in the
# machine store; signtool.exe and makensis must be on PATH (or set the paths).
CONXA_SIGN_CERT_SHA1=
# CONXA_SIGNTOOL_PATH=signtool.exe
# MAKENSIS_PATH=makensis
