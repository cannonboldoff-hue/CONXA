# ============================================================================
# Conxa — DEVELOPMENT environment  (.env.dev)
# ============================================================================
# Loaded automatically when CONXA_ENV=dev (the default). Values here are the
# *dev lane*: isolated paths, dev/local endpoints, auth off, Cashfree sandbox.
# The dev/prod launcher (scripts/conxa.sh · conxa.ps1) exports CONXA_ENV and the
# path roots below so Dev and Prod coexist on one machine with zero interference.
#
# NOTHING in this file should ever point at production (apis.conxa.in / prod DB /
# prod Clerk / Cashfree PROD). Keep the two lanes physically separate.
#
# Only the multi-provider LLM keys were carried over from the shared key pool —
# those are lane-agnostic billing accounts. All prod-only secrets (live Clerk key,
# prod Postgres, Cashfree PROD, tracking/proxy/installer secrets) were left out
# on purpose.

# ── The single switch ───────────────────────────────────────────────────────
CONXA_ENV=dev
# Update channel this lane publishes to and pulls from (dev prereleases only).
CONXA_UPDATE_CHANNEL=dev

# ── Isolated local path roots (normally set by the launcher; shown for clarity)
# Runtime install + writable data + app layer, all under a *-dev tree.
# CONXA_DIR=~/.conxa-dev
# CONXA_DATA_DIR=~/.conxa-dev/data            # Windows: %APPDATA%\Conxa-Dev
# CONXA_APP_DIR=~/.conxa-dev/conxa-app
# Build Studio state (deps cache, sandbox, generated bundles).
# CONXA_STUDIO_HOME=~/.conxa-build-studio-dev

# ============================================================================
# LLM Key Pool — three symmetric, single-deployment tiers — see .env.example for docs
# ============================================================================
# Free/Starter run on OpenRouter, Pro direct on Anthropic (docs/cost_model.md
# "LLM Provider Strategy", 2026-09-23) — the old multi-provider free-tier-
# rotation pool was retired.
LLM_FREE_PROVIDER=openrouter
LLM_FREE_ENDPOINT=https://openrouter.ai/api/v1
LLM_FREE_API_KEYS=
LLM_FREE_TEXT_MODEL=z-ai/glm-5.3-flash
LLM_FREE_VISION_MODEL=qwen/qwen3-vl-235b-a22b-instruct

# Starter (Kimi K3 + Qwen3 VL, via OpenRouter) and Pro (Claude Sonnet 5 +
# Claude Opus 5.5, direct to Anthropic) — blank here so local dev falls back
# to the Free/OpenRouter pool above. See .env.example for the full tier block.
LLM_STARTER_PROVIDER=
LLM_STARTER_ENDPOINT=
LLM_STARTER_API_KEYS=
LLM_PRO_PROVIDER=
LLM_PRO_ENDPOINT=
LLM_PRO_API_KEYS=

# Router tuning (carried from the shared pool config — helps free-tier resilience)
LLM_ROUTER_COOLDOWN_SECS=60
LLM_ROUTER_MAX_RETRIES=3
LLM_ROUTER_PREFER_FAST_FOR_TEXT=true
LLM_ROUTER_REQUEST_TIMEOUT_MS=30000

# ============================================================================
# Cloud endpoints — DEV lane
# ============================================================================
# Local-first: defaults to your machine. Repoint at a hosted dev tier
# (https://dev-apis.conxa.in) with NO code change when you want integration.
CONXA_CLOUD_API=http://127.0.0.1:8000
CONXA_API_URL=http://127.0.0.1:8000
# Public base embedded into pack.json (sync + tracking) at publish time. MUST be
# the dev cloud so dev-built installers never phone home to prod.
SKILL_API_BASE_URL=http://127.0.0.1:8000

# GitHub repo hosting release artifacts (same repo; dev uses -dev.N prereleases).
CONXA_GITHUB_REPO=cannonboldoff-hue/CONXA
CONXA_RUNTIME_CDN_URL=https://github.com/cannonboldoff-hue/CONXA/releases/download

# Component version pins (dev prereleases).
CONXA_HOST_VERSION=host-v1.2.3
CONXA_APP_VERSION=app-v1.3.4
CONXA_APP_MIN_HOST=host-v1.2.3
CONXA_STUDIO_VERSION=studio-v1.0.0
CONXA_PLAYWRIGHT_VERSION=1.59.0
CONXA_CHROMIUM_REVISION=1227
CONXA_NSIS_VERSION=3.10
CONXA_NSIS_URL=https://downloads.sourceforge.net/project/nsis/NSIS%203/3.10/nsis-3.10.zip
CONXA_ADMIN_TOKEN=
CONXA_DEPS_MANIFEST_TTL_SECONDS=86400

# ============================================================================
# Auth + backing services — DEV lane (isolated from prod)
# ============================================================================
# Dev runs auth OFF by default (filesystem store, unlimited "development" plan).
# To exercise the real Clerk/DB path end-to-end, provision a SEPARATE dev Clerk
# instance + dev Postgres. Never reuse the prod values from the shared api env.
SKILL_AUTH_REQUIRED=false
SKILL_CLERK_ISSUER=
SKILL_CLERK_JWKS_URL=
SKILL_CLERK_AUTHORIZED_PARTIES=
SKILL_CLERK_AUDIENCE=
CLERK_SECRET_KEY=
SKILL_API_PROXY_SHARED_SECRET=

# Dashboard "Report a bug" page — email via Resend's HTTPS API. Leave blank to
# disable the feature (503); set it to test the flow locally.
SKILL_RESEND_API_KEY=
SKILL_BUG_REPORT_TO_EMAIL=

# Empty = filesystem fallback (local dev). Point at a dev Postgres for a hosted tier.
SKILL_DATABASE_URL=
SKILL_REDIS_URL=
SKILL_BLOB_READ_WRITE_TOKEN=

# Build Studio Electron — Clerk OAuth (dev instance).
CONXA_CLERK_DOMAIN=https://clerk.conxa.in
CONXA_CLERK_CLIENT_ID=Z7O8UdIVowd3Aegx
CONXA_CLERK_CLIENT_SECRET=

# Tracking HMAC secret (leave blank in local dev → tracking targets local cloud).
SKILL_TRACKING_HMAC_SECRET=

# ── Cashfree billing — DEV uses the sandbox ─────────────────────────────────
# Blank on purpose: the shared api env only has PROD Cashfree creds, which must
# never enter the dev lane. Fill with Cashfree sandbox (TEST) creds if needed.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_WEBHOOK_SECRET=
CASHFREE_ENV=TEST
CASHFREE_STARTER_PLAN_ID=
CASHFREE_PRO_PLAN_ID=
# Compile add-on packs are ONE-TIME purchases via Cashfree Payment Links —
# no plan IDs needed for them.

# ── Agent-installer code signing (blank in dev → unsigned test installers) ───
CONXA_SIGN_CERT_SHA1=
