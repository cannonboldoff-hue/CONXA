# ============================================================================
# Conxa — PRODUCTION environment  (copy to .env.prod)
# ============================================================================
# Loaded automatically only when CONXA_ENV=prod (explicit opt-in). This is the
# *prod lane*: the live cloud (apis.conxa.in), real Clerk auth, Postgres, and
# Cashfree PROD. The backend REFUSES TO BOOT unless the auth/DB/Cashfree values
# below are all set (see conxa-cloud/backend/app/main.py:_validate_production_config).
#
# On Render/Vercel these are set as dashboard secrets, not committed. This file is
# the authoritative checklist of what prod requires.

# ── The single switch ───────────────────────────────────────────────────────
CONXA_ENV=prod
CONXA_UPDATE_CHANNEL=stable

# ── Path roots (prod install tree; normally the installer/launcher sets these) ─
# CONXA_DIR=~/.conxa
# CONXA_DATA_DIR=~/.conxa/data                 # Windows: %APPDATA%\Conxa
# CONXA_APP_DIR=~/.conxa/conxa-app
# CONXA_STUDIO_HOME=~/.conxa-build-studio

# ============================================================================
# LLM Key Pool — three symmetric, single-deployment tiers — production keys
# (see .env.example for docs)
# ============================================================================
# Free/Starter run on OpenRouter, Pro direct on Anthropic (docs/cost_model.md
# "LLM Provider Strategy", 2026-09-23) — the old multi-provider free-tier-
# rotation pool was retired.
LLM_FREE_PROVIDER=openrouter
LLM_FREE_ENDPOINT=https://openrouter.ai/api/v1
LLM_FREE_API_KEYS=
LLM_FREE_TEXT_MODEL=z-ai/glm-5.3-flash
LLM_FREE_VISION_MODEL=qwen/qwen3-vl-235b-a22b-instruct

# Starter: Kimi K3 + Qwen3 VL, via OpenRouter (usually the same key as above,
# on its own var so Starter access can be rotated independently).
LLM_STARTER_PROVIDER=openrouter
LLM_STARTER_ENDPOINT=https://openrouter.ai/api/v1
LLM_STARTER_API_KEYS=
LLM_STARTER_TEXT_MODEL=moonshotai/kimi-k3
LLM_STARTER_VISION_MODEL=qwen/qwen3-vl-235b-a22b-instruct

# Pro: Claude Sonnet 5 + Claude Opus 5.5, direct to Anthropic (its own
# OpenAI-compatible endpoint — no OpenRouter fee).
LLM_PRO_PROVIDER=anthropic
LLM_PRO_ENDPOINT=https://api.anthropic.com/v1
LLM_PRO_API_KEYS=
LLM_PRO_TEXT_MODEL=claude-sonnet-5
LLM_PRO_VISION_MODEL=claude-opus-5-5

# ============================================================================
# Cloud endpoints — PROD lane
# ============================================================================
CONXA_CLOUD_API=https://apis.conxa.in
CONXA_API_URL=https://apis.conxa.in
# Required in prod: pins the base embedded into pack.json, preventing
# X-Forwarded-Host injection. Boot fails if unset.
SKILL_API_BASE_URL=https://apis.conxa.in

CONXA_GITHUB_REPO=cannonboldoff-hue/CONXA
CONXA_RUNTIME_CDN_URL=https://github.com/cannonboldoff-hue/CONXA/releases/download

# Component version pins (promoted stable releases only).
CONXA_HOST_VERSION=host-v1.0.0
CONXA_APP_VERSION=app-v1.0.0
CONXA_APP_MIN_HOST=host-v1.0.0
CONXA_STUDIO_VERSION=studio-v1.0.0
CONXA_PLAYWRIGHT_VERSION=1.59.0
CONXA_CHROMIUM_REVISION=1227
CONXA_NSIS_VERSION=3.10
CONXA_NSIS_URL=https://downloads.sourceforge.net/project/nsis/NSIS%203/3.10/nsis-3.10.zip
CONXA_ADMIN_TOKEN=
CONXA_DEPS_MANIFEST_TTL_SECONDS=86400

# ============================================================================
# Auth + backing services — PROD lane (all REQUIRED; boot fails if missing)
# ============================================================================
SKILL_AUTH_REQUIRED=true
SKILL_CLERK_ISSUER=
SKILL_CLERK_JWKS_URL=
SKILL_CLERK_AUTHORIZED_PARTIES=
SKILL_CLERK_AUDIENCE=
CLERK_SECRET_KEY=
SKILL_API_PROXY_SHARED_SECRET=

# Postgres is mandatory in prod — the filesystem fallback is refused.
SKILL_DATABASE_URL=
SKILL_REDIS_URL=
SKILL_BLOB_READ_WRITE_TOKEN=

# Build Studio Electron — Clerk OAuth (prod instance).
CONXA_CLERK_DOMAIN=https://clerk.conxa.in
CONXA_CLERK_CLIENT_ID=Z7O8UdIVowd3Aegx
CONXA_CLERK_CLIENT_SECRET=

# Company-scoped runtime telemetry signing. Required for prod tracking.
SKILL_TRACKING_HMAC_SECRET=

# Signs time-limited installer download links (SG-07). Required in prod.
SKILL_INSTALLER_SIGNING_KEY=

# Dashboard "Report a bug" page — email via Resend's HTTPS API (Render's free
# plan blocks outbound SMTP). Leave blank to disable the feature (503).
SKILL_RESEND_API_KEY=
SKILL_BUG_REPORT_TO_EMAIL=
# onboarding@resend.dev works with zero setup, but only when
# SKILL_BUG_REPORT_TO_EMAIL is the Resend account owner's own address — verify
# a sending domain in Resend before using any other "to" address.
SKILL_BUG_REPORT_FROM_EMAIL=Conxa Bug Reports <onboarding@resend.dev>

# ── Cashfree billing — PROD (live) ──────────────────────────────────────────
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_WEBHOOK_SECRET=
CASHFREE_ENV=PROD
CASHFREE_STARTER_PLAN_ID=
CASHFREE_PRO_PLAN_ID=
# Compile add-on packs are ONE-TIME purchases via Cashfree Payment Links —
# no plan IDs needed for them.

# ── Agent-installer code signing (set once an EV/OV cert is available) ───────
CONXA_SIGN_CERT_SHA1=
# CONXA_SIGNTOOL_PATH=signtool.exe
# MAKENSIS_PATH=makensis
