# ============================================================================
# Conxa — PRODUCTION environment  (copy to .env.prod)
# ============================================================================
# Loaded only when CONXA_ENV=prod. This is the live cloud (apis.conxa.in): real
# Clerk auth, Postgres, Cashfree PROD. The backend REFUSES TO BOOT unless every
# value marked REQUIRED below is set (conxa-cloud/backend/app/main.py:
# _validate_production_config).
#
# On Render/Vercel these are dashboard secrets, not committed. This file is the
# checklist of what prod needs.
#
# Sections:
#   1. Environment switch
#   2. Public URLs
#   3. AI models  — Free plan / Starter plan / Pro plan / Video / Router
#   4. Login (Clerk)
#   5. Data stores
#   6. Security secrets
#   7. Billing (Cashfree)
#   8. Bug-report email
#   9. Release versions (Studio, runtime, installer tools)
#  10. Installer code signing
#
# Naming: LLM_<PLAN>_<WHAT>. Each plan has exactly two models, a MULTIMODAL
# model (handles text and screenshots) and its MULTIMODAL_FALLBACK, tried on the
# same key if the main one fails. Video has one model + one fallback for all plans.


# ============================================================================
# 1. ENVIRONMENT SWITCH
# ============================================================================
CONXA_ENV=prod
CONXA_UPDATE_CHANNEL=stable


# ============================================================================
# 2. PUBLIC URLS
# ============================================================================
CONXA_CLOUD_API=https://apis.conxa.in
CONXA_API_URL=https://apis.conxa.in
# REQUIRED. Pins the base URL written into pack.json (stops X-Forwarded-Host injection).
SKILL_API_BASE_URL=https://apis.conxa.in


# ============================================================================
# 3. AI MODELS
# ============================================================================
# A plan with no API key gets no pool, and its compiles fall back to the Free plan.
# At least one plan must have a key.

# --- 3a. FREE plan — via OpenRouter -----------------------------------------
LLM_FREE_PROVIDER=openrouter
LLM_FREE_ENDPOINT=https://openrouter.ai/api/v1
LLM_FREE_API_KEYS=
LLM_FREE_MULTIMODAL_MODEL=qwen/qwen3-vl-235b-a22b-instruct
LLM_FREE_MULTIMODAL_FALLBACK_MODEL=

# --- 3b. STARTER plan — via OpenRouter --------------------------------------
# Usually the same OpenRouter key as Free, kept on its own variable so Starter
# access can be rotated or revoked on its own.
LLM_STARTER_PROVIDER=openrouter
LLM_STARTER_ENDPOINT=https://openrouter.ai/api/v1
LLM_STARTER_API_KEYS=
LLM_STARTER_MULTIMODAL_MODEL=qwen/qwen3-vl-235b-a22b-instruct
LLM_STARTER_MULTIMODAL_FALLBACK_MODEL=

# --- 3c. PRO plan — direct to Anthropic (no OpenRouter fee) -----------------
LLM_PRO_PROVIDER=anthropic
LLM_PRO_ENDPOINT=https://api.anthropic.com/v1
LLM_PRO_API_KEYS=
LLM_PRO_MULTIMODAL_MODEL=claude-sonnet-5
LLM_PRO_MULTIMODAL_FALLBACK_MODEL=claude-opus-5-5

# --- 3d. VIDEO — recording analysis (TwelveLabs), same for every plan -------
# REQUIRED in prod: recording needs it. Old names SKILL_TWELVELABS_API_KEY and
# SKILL_TWELVELABS_BASE_URL still work.
LLM_VIDEO_API_KEY=
LLM_VIDEO_ENDPOINT=https://api.twelvelabs.io/v1.3
LLM_VIDEO_MODEL=pegasus1.6
LLM_VIDEO_FALLBACK_MODEL=

# --- 3e. DECISIONS — Proof-of-Done picker, same for every plan ---------------
# Optional. A decision model answers yes/no questions with a probability and
# writes no text; compile uses it to pick which proof checks to build.
# Blank key = picker off, and compile builds checks from code alone.
LLM_DECISIONS_API_KEY=
LLM_DECISIONS_ENDPOINT=https://openrouter.ai/api/alpha
LLM_DECISIONS_PATH=/decisions
LLM_DECISIONS_MODEL=openai/gpt-6-luna-decisions

# --- 3f. Router behaviour (optional; these are the defaults) ----------------
# LLM_ROUTER_COOLDOWN_SECS=60               # rest a key this long after a rate-limit (429)
# LLM_ROUTER_MAX_RETRIES=3                  # retries before a request gives up
# LLM_ROUTER_REQUEST_TIMEOUT_MS=30000       # per-request timeout


# ============================================================================
# 4. LOGIN (Clerk) — all REQUIRED
# ============================================================================
SKILL_AUTH_REQUIRED=true
SKILL_CLERK_ISSUER=
SKILL_CLERK_JWKS_URL=
SKILL_CLERK_AUTHORIZED_PARTIES=
SKILL_CLERK_AUDIENCE=
CLERK_SECRET_KEY=


# ============================================================================
# 5. DATA STORES — all REQUIRED (Postgres is mandatory; no filesystem fallback)
# ============================================================================
SKILL_DATABASE_URL=
SKILL_REDIS_URL=
SKILL_BLOB_READ_WRITE_TOKEN=


# ============================================================================
# 6. SECURITY SECRETS — REQUIRED
# ============================================================================
SKILL_API_PROXY_SHARED_SECRET=
# Signs runtime telemetry per company.
SKILL_TRACKING_HMAC_SECRET=
# Signs time-limited installer download links (SG-07).
SKILL_INSTALLER_SIGNING_KEY=
# Used by CI to post updated release manifests.
CONXA_ADMIN_TOKEN=


# ============================================================================
# 7. BILLING (Cashfree) — LIVE
# ============================================================================
CASHFREE_ENV=PROD
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_WEBHOOK_SECRET=
CASHFREE_STARTER_PLAN_ID=
CASHFREE_PRO_PLAN_ID=
# Compile add-on packs are one-time purchases (Payment Links), so they need no plan IDs.


# ============================================================================
# 8. BUG-REPORT EMAIL (optional; blank = feature off)
# ============================================================================
# Sent through Resend's HTTPS API (Render's free plan blocks SMTP).
SKILL_RESEND_API_KEY=
SKILL_BUG_REPORT_TO_EMAIL=
# onboarding@resend.dev only works when the "to" address is the Resend account
# owner's own. Verify a sending domain in Resend before using any other address.
SKILL_BUG_REPORT_FROM_EMAIL=Conxa Bug Reports <onboarding@resend.dev>


# ============================================================================
# 9. RELEASE VERSIONS (promoted stable releases only)
# ============================================================================
CONXA_GITHUB_REPO=cannonboldoff-hue/CONXA
CONXA_RUNTIME_CDN_URL=https://github.com/cannonboldoff-hue/CONXA/releases/download

CONXA_STUDIO_VERSION=studio-v1.0.0
CONXA_HOST_VERSION=host-v1.0.0
CONXA_APP_VERSION=app-v1.0.0
CONXA_APP_MIN_HOST=host-v1.0.0

CONXA_PLAYWRIGHT_VERSION=1.59.0
CONXA_CHROMIUM_REVISION=1227
CONXA_NSIS_VERSION=3.10
CONXA_NSIS_URL=https://downloads.sourceforge.net/project/nsis/NSIS%203/3.10/nsis-3.10.zip
CONXA_DEPS_MANIFEST_TTL_SECONDS=86400

# Install-path roots (the installer/launcher normally sets these)
# CONXA_DIR=~/.conxa
# CONXA_DATA_DIR=~/.conxa/data                 # Windows: %APPDATA%\Conxa
# CONXA_APP_DIR=~/.conxa/conxa-app
# CONXA_STUDIO_HOME=~/.conxa-build-studio


# ============================================================================
# 10. INSTALLER CODE SIGNING (set once an EV/OV certificate exists)
# ============================================================================
CONXA_SIGN_CERT_SHA1=
# CONXA_SIGNTOOL_PATH=signtool.exe
# MAKENSIS_PATH=makensis
