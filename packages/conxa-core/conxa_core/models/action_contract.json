{
  "version": 1,
  "about": "What every recorded action kind becomes and how the runtime runs it. Read by two tests only (conxa-cloud/tests/test_action_contract.py and runtime/test/unit/test_action_contract.js); nothing reads it at run time. Adding a kind: add it to ActionKind (events.py), add one entry here, and the tests say what else is missing.",
  "fields": {
    "step": "the execution-step type the kind becomes in execution.json, or null when it never becomes a step on its own",
    "run": "handler = a function in runtime/app/handlers.js HANDLERS; noop = listed in NOOP_STEP_TYPES; intercept = handled before dispatch (PRE_DISPATCH_STEP_TYPES)",
    "recovery": "whether compiler/action_policy.py gives the kind a recovery block (false means no_recovery_block)",
    "via": "packager = skill_package_builder_saved_skill._saved_step_to_execution_step builds it from a minimal saved step; own_builder = a dedicated builder (branch, fork); compiler = compiler/build.py rewrites it before the packager sees it"
  },
  "kinds": {
    "click":             {"step": "click",             "run": "handler",   "recovery": true,  "via": "packager"},
    "dblclick":          {"step": "dblclick",          "run": "handler",   "recovery": true,  "via": "packager"},
    "right_click":       {"step": "right_click",       "run": "handler",   "recovery": true,  "via": "packager"},
    "hover":             {"step": "hover",             "run": "handler",   "recovery": true,  "via": "packager"},
    "type":              {"step": "type",              "run": "handler",   "recovery": true,  "via": "packager"},
    "fill":              {"step": "fill",              "run": "handler",   "recovery": true,  "via": "packager"},
    "set_checkbox":      {"step": "set_checkbox",      "run": "handler",   "recovery": true,  "via": "packager"},
    "set_radio":         {"step": "set_radio",         "run": "handler",   "recovery": true,  "via": "packager"},
    "select":            {"step": "select",            "run": "handler",   "recovery": true,  "via": "packager"},
    "select_option":     {"step": "select_option",     "run": "handler",   "recovery": true,  "via": "packager"},
    "date_pick":         {"step": "date_pick",         "run": "handler",   "recovery": true,  "via": "packager"},
    "drag_drop":         {"step": "drag_drop",         "run": "handler",   "recovery": true,  "via": "packager"},
    "keyboard_shortcut": {"step": "keyboard_shortcut", "run": "handler",   "recovery": true,  "via": "packager"},
    "scroll":            {"step": "scroll",            "run": "handler",   "recovery": false, "via": "packager"},
    "navigate":          {"step": "navigate",          "run": "handler",   "recovery": false, "via": "packager"},
    "browser_back":      {"step": "browser_back",      "run": "handler",   "recovery": false, "via": "packager"},
    "browser_forward":   {"step": "browser_forward",   "run": "handler",   "recovery": false, "via": "packager"},
    "manual_navigate":   {"step": "navigate",          "run": "handler",   "recovery": false, "via": "compiler"},
    "tab_open":          {"step": "tab_open",          "run": "handler",   "recovery": false, "via": "packager"},
    "tab_switch":        {"step": "tab_switch",        "run": "handler",   "recovery": false, "via": "packager"},
    "popup":             {"step": "popup",             "run": "handler",   "recovery": false, "via": "packager"},
    "frame_enter":       {"step": "frame_enter",       "run": "noop",      "recovery": false, "via": "packager"},
    "frame_exit":        {"step": "frame_exit",        "run": "noop",      "recovery": false, "via": "packager"},
    "upload_intent":     {"step": "upload",            "run": "handler",   "recovery": false, "via": "packager"},
    "upload":            {"step": "upload",            "run": "handler",   "recovery": true,  "via": "packager"},
    "download_observed": {"step": "download_observed", "run": "handler",   "recovery": false, "via": "packager"},
    "dialog_appeared":   {"step": "dialog_appeared",   "run": "noop",      "recovery": false, "via": "packager"},
    "dialog_accept":     {"step": "dialog_accept",     "run": "handler",   "recovery": false, "via": "packager"},
    "dialog_dismiss":    {"step": "dialog_dismiss",    "run": "handler",   "recovery": false, "via": "packager"},
    "file_chooser_opened": {"step": "file_chooser_opened", "run": "noop",  "recovery": false, "via": "packager"},
    "clipboard_copy":    {"step": "clipboard_copy",    "run": "noop",      "recovery": false, "via": "packager"},
    "clipboard_paste":   {"step": "clipboard_paste",   "run": "noop",      "recovery": false, "via": "packager"},
    "wait":              {"step": "wait",              "run": "handler",   "recovery": false, "via": "packager"},
    "assert":            {"step": "assert",            "run": "handler",   "recovery": false, "via": "packager"},
    "screenshot":        {"step": "screenshot",        "run": "handler",   "recovery": false, "via": "packager"},
    "extract":           {"step": "extract",           "run": "handler",   "recovery": true,  "via": "packager"},
    "if_present":        {"step": "if_present",        "run": "handler",   "recovery": false, "via": "own_builder"},
    "try_dismiss":       {"step": "try_dismiss",       "run": "handler",   "recovery": false, "via": "own_builder"},
    "wait_for_one_of":   {"step": "wait_for_one_of",   "run": "handler",   "recovery": false, "via": "own_builder"},
    "outcome_fork":      {"step": "outcome_fork",      "run": "intercept", "recovery": false, "via": "own_builder"},
    "focus":             {"step": "focus",             "run": "handler",   "recovery": true,  "via": "packager"},
    "check":             {"step": "check",             "run": "handler",   "recovery": false, "via": "packager"}
  },
  "step_only": {
    "handover":        {"run": "intercept", "recovery": false},
    "agent_span":      {"run": "intercept", "recovery": false},
    "for_each":        {"run": "intercept", "recovery": false},
    "call_workflow":   {"run": "intercept", "recovery": false},
    "wait_until":      {"run": "handler",   "recovery": false},
    "clipboard_write": {"run": "handler",   "recovery": false},
    "clipboard_read":  {"run": "handler",   "recovery": false}
  },
  "packager_only": {
    "repeat_click": {"run": "handler", "recovery": true, "from": "click", "about": "a click recorded as repeated on purpose; a new TYPE (not a field) so a runtime that predates it refuses the step"}
  }
}
